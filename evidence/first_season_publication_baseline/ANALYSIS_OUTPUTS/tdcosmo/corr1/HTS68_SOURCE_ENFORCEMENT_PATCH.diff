+def load_paper_reference(path: Path) -> tuple[list[dict[str, str]], list[str]]:
+    required_fields = {
+        "release_model_id",
+        "model_label",
+        "paper_table_row",
+        "h0_median",
+        "h0_lower_error_magnitude",
+        "h0_upper_error_magnitude",
+        "paper_identifier",
+        "paper_version",
+        "transcription_method",
+        "source_location",
+    }
+    issues: list[str] = []
+    if not path.is_file():
+        return [], [f"MISSING_REQUIRED_INPUT:{path.name}"]
+    with path.open("r", encoding="utf-8", newline="") as handle:
+        reader = csv.DictReader(handle, delimiter="\t")
+        fields = set(reader.fieldnames or [])
+        if fields != required_fields:
+            issues.append(
+                "PAPER_REFERENCE_SCHEMA_MISMATCH:"
+                f"expected={sorted(required_fields)}:actual={sorted(fields)}"
+            )
+        rows = list(reader)
+    expected_ids = {
+        "ULambdaCDM1",
+        "ULambdaCDM2",
+        "ULambdaCDM3",
+        "ULambdaCDM4",
+        "LambdaCDM1a",
+        "LambdaCDM1b",
+        "LambdaCDM1c",
+        "LambdaCDM1d",
+        "LambdaCDM2a",
+        "LambdaCDM2d",
+        "LambdaCDM3a",
+        "LambdaCDM3b",
+    }
+    actual_ids = {row.get("release_model_id", "") for row in rows}
+    if len(rows) != 12 or actual_ids != expected_ids:
+        issues.append(
+            "PAPER_REFERENCE_ROW_SET_MISMATCH:"
+            f"count={len(rows)}:ids={sorted(actual_ids)}"
+        )
+    return rows, issues
+
